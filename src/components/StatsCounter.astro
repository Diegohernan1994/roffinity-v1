---
// 6 Metrics Counter Component (About Bottom in EcoReal)
---

<section class="about-bottom">
  <div class="container">
    <div class="row">
      
      <!-- Metric 1: Experience -->
      <div class="col-md-2 col-sm-4 col-xs-6 property-pros wow fadeIn text-center" data-wow-duration="1.2s" data-wow-delay="0.2s">
        <div class="fig">
          <i class="fa fa-calendar-check-o"></i>
        </div>
        <span>Years of Excellence</span>
        <span class="fign">20+</span>		
      </div>

      <!-- Metric 2: Completed Projects -->
      <div class="col-md-2 col-sm-4 col-xs-6 property-pros wow fadeIn text-center" data-wow-duration="1.2s" data-wow-delay="0.3s">
        <div class="fig">
          <i class="fa fa-home"></i>
        </div>
        <span>Roofs Completed</span>
        <span class="fign">3,500+</span> 
      </div>

      <!-- Metric 3: Warranty -->
      <div class="col-md-2 col-sm-4 col-xs-6 property-pros wow fadeIn text-center" data-wow-duration="1.2s" data-wow-delay="0.4s">
        <div class="fig">
          <i class="fa fa-shield"></i>
        </div>
        <span>System Warranty</span>
        <span class="fign">50 Yrs</span> 
      </div>

      <!-- Metric 4: Square Feet -->
      <div class="col-md-2 col-sm-4 col-xs-6 property-pros wow fadeIn text-center" data-wow-duration="1.2s" data-wow-delay="0.5s">
        <div class="fig">
          <i class="fa fa-object-group"></i>
        </div>
        <span>Square Feet Installed</span>
        <span class="fign">12.5M+</span> 
      </div>

      <!-- Metric 5: Master Crews -->
      <div class="col-md-2 col-sm-4 col-xs-6 property-pros wow fadeIn text-center" data-wow-duration="1.2s" data-wow-delay="0.6s">
        <div class="fig">
          <i class="fa fa-users"></i>
        </div>
        <span>Certified Crews</span>
        <span class="fign">18</span> 
      </div>

      <!-- Metric 6: Emergency Response -->
      <div class="col-md-2 col-sm-4 col-xs-6 property-pros wow fadeIn text-center" data-wow-duration="1.2s" data-wow-delay="0.7s">
        <div class="fig">
          <i class="fa fa-bolt"></i>
        </div>
        <span>Emergency Dispatch</span>
        <span class="fign">24/7</span>  
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    .about-bottom {
      padding: 40px 0 !important;
    }
    .about-bottom .fig {
      height: 80px !important;
      width: 80px !important;
      padding: 0 !important;
      margin: 0 auto 10px auto !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .about-bottom .fig i {
      font-size: 28px !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .property-pros {
      margin-bottom: 30px !important;
    }
    .about-bottom span {
      font-size: 12px !important;
      line-height: 1.2 !important;
      margin-bottom: 5px !important;
    }
    .about-bottom .fign {
      padding-top: 0 !important;
      font-size: 20px !important;
      margin-top: 5px !important;
    }
  }
</style>

