---
// Recent Projects Section (Latest Properties in EcoReal)
---

<section class="latest-property" id="latest-projects">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center"> 
        <div class="property">
          <h1 class="section-heading wow fadeInUp" data-wow-duration="1.2s" data-wow-delay="0s">
            Recent <span style="color: #2384EC;">Installations</span>
          </h1>
          <p class="section-desc wow fadeInUp" data-wow-duration="1.2s" data-wow-delay="0.1s">
            Take an in-depth look at our most recent residential and commercial roofing achievements. Every installation includes full underlayment replacement, premium flashing, and comprehensive warranty registration.
          </p> 
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Projects Grid -->
<section class="property-lists">
  <div class="container">
    <div class="row hidden-xs" style="display: flex; flex-wrap: wrap; align-items: stretch;">
      
      <!-- Project 1 -->
      <div class="col-md-4 col-sm-6 wow fadeInUp" style="display: flex; flex-direction: column; margin-bottom: 30px; visibility: visible; animation-name: fadeInUp;">
        <div class="latest-pic1" style="height: 230px; background-image: url('/images/hero/hero-slide-1.jpg'); background-size: cover; background-position: center;"></div>
        <div class="latest-pic-bottom" style="flex: 1; display: flex; flex-direction: column;">
          <div class="pic-address">Pasadena, CA</div>
          <div class="description-wrap" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div class="pic-description">
              <h3><a href="#" data-toggle="modal" data-target="#scheduleModal">Asphalt Shingles: Craftsman Replacement</a></h3>
              <p>Complete tear-off and replacement with GAF Timberline HDZ Charcoal shingles and ridge ventilation.</p>
            </div>
            <div class="pic-mesure">
              <span><i class="fa fa-object-group"></i> 3,200 sq ft</span>
              <span><i class="fa fa-shield"></i> 50-Yr Warranty</span>
              <span><i class="fa fa-check-circle"></i> Class 4</span> 
            </div>
          </div>
        </div>       
      </div>

      <!-- Project 2 -->
      <div class="col-md-4 col-sm-6 wow fadeInUp" style="display: flex; flex-direction: column; margin-bottom: 30px; visibility: visible; animation-name: fadeInUp;">
        <div class="latest-pic2" style="height: 230px; background-image: url('/images/hero/hero-slide-2.jpg'); background-size: cover; background-position: center;"></div>
        <div class="latest-pic-bottom" style="flex: 1; display: flex; flex-direction: column;">
          <div class="pic-address">Beverly Hills, CA</div>
          <div class="description-wrap" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div class="pic-description">
              <h3><a href="#" data-toggle="modal" data-target="#scheduleModal">Spanish Tile Restoration</a></h3>
              <p>Careful removal of historic clay tiles, double-layer synthetic underlayment installation, and tile resetting.</p>
            </div>
            <div class="pic-mesure">
              <span><i class="fa fa-object-group"></i> 4,500 sq ft</span>
              <span><i class="fa fa-shield"></i> Lifetime</span>
              <span><i class="fa fa-check-circle"></i> Preserved</span> 
            </div>
          </div>
        </div>       
      </div>

      <!-- Project 3 -->
      <div class="col-md-4 col-sm-6 wow fadeInUp" style="display: flex; flex-direction: column; margin-bottom: 30px; visibility: visible; animation-name: fadeInUp;">
        <div class="latest-pic3" style="height: 230px; background-image: url('/images/hero/hero-slide-3.jpg'); background-size: cover; background-position: center;"></div>
        <div class="latest-pic-bottom" style="flex: 1; display: flex; flex-direction: column;">
          <div class="pic-address">Irvine, CA (Business Park)</div>
          <div class="description-wrap" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div class="pic-description">
              <h3><a href="#" data-toggle="modal" data-target="#scheduleModal">Commercial TPO Single-Ply</a></h3>
              <p>60-mil white TPO membrane installation over rigid ISO insulation for maximum energy efficiency.</p>
            </div>
            <div class="pic-mesure">
              <span><i class="fa fa-object-group"></i> 12,000 sq ft</span>
              <span><i class="fa fa-shield"></i> 20-Yr NDL</span>
              <span><i class="fa fa-check-circle"></i> Title 24</span> 
            </div>
          </div>
        </div>       
      </div>
    </div>

    <!-- Mobile Carousel View (Visible only on Mobile) -->
    <div class="visible-xs-block" style="margin-top: 0px;">
      <div id="latest-projects-mobile-carousel" class="owl-carousel owl-theme">
        
        <!-- Mobile Project 1 -->
        <div class="item">
          <div class="mobile-project-card" style="display: flex; flex-direction: column; margin-bottom: 10px; background: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.06); height: 100%;">
            <div style="height: 230px; background-image: url('/images/hero/hero-slide-1.jpg'); background-size: cover; background-position: center;"></div>
            <div style="padding: 15px; display: flex; flex-direction: column; flex: 1; min-height: 250px;">
              <div style="font-size: 13px; font-weight: 700; color: #2384EC; margin-bottom: 5px;">Pasadena, CA</div>
              <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 10px 0;"><a href="#" style="color: #333;">Asphalt Shingles: Craftsman Replacement</a></h3>
              <p style="font-size: 14px; color: #666; margin-bottom: 15px; line-height: 1.5;">Complete tear-off and replacement with GAF Timberline HDZ Charcoal shingles and ridge ventilation.</p>
              <div style="font-size: 13px; color: #555; display: flex; justify-content: space-between; margin-top: auto;">
                <span><i class="fa fa-object-group" style="color: #4cb050;"></i> 3,200 sq ft</span>
                <span><i class="fa fa-shield" style="color: #4cb050;"></i> 50-Yr</span>
                <span><i class="fa fa-check-circle" style="color: #4cb050;"></i> Class 4</span> 
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile Project 2 -->
        <div class="item">
          <div class="mobile-project-card" style="display: flex; flex-direction: column; margin-bottom: 10px; background: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.06); height: 100%;">
            <div style="height: 230px; background-image: url('/images/hero/hero-slide-2.jpg'); background-size: cover; background-position: center;"></div>
            <div style="padding: 15px; display: flex; flex-direction: column; flex: 1; min-height: 250px;">
              <div style="font-size: 13px; font-weight: 700; color: #2384EC; margin-bottom: 5px;">Beverly Hills, CA</div>
              <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 10px 0;"><a href="#" style="color: #333;">Spanish Tile Restoration</a></h3>
              <p style="font-size: 14px; color: #666; margin-bottom: 15px; line-height: 1.5;">Careful removal of historic clay tiles, double-layer synthetic underlayment installation, and tile resetting.</p>
              <div style="font-size: 13px; color: #555; display: flex; justify-content: space-between; margin-top: auto;">
                <span><i class="fa fa-object-group" style="color: #4cb050;"></i> 4,500 sq ft</span>
                <span><i class="fa fa-shield" style="color: #4cb050;"></i> Lifetime</span>
                <span><i class="fa fa-check-circle" style="color: #4cb050;"></i> Preserved</span> 
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile Project 3 -->
        <div class="item">
          <div class="mobile-project-card" style="display: flex; flex-direction: column; margin-bottom: 10px; background: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.06); height: 100%;">
            <div style="height: 230px; background-image: url('/images/hero/hero-slide-3.jpg'); background-size: cover; background-position: center;"></div>
            <div style="padding: 15px; display: flex; flex-direction: column; flex: 1; min-height: 250px;">
              <div style="font-size: 13px; font-weight: 700; color: #2384EC; margin-bottom: 5px;">Irvine, CA (Business Park)</div>
              <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 10px 0;"><a href="#" style="color: #333;">Commercial TPO Single-Ply</a></h3>
              <p style="font-size: 14px; color: #666; margin-bottom: 15px; line-height: 1.5;">60-mil white TPO membrane installation over rigid ISO insulation for maximum energy efficiency.</p>
              <div style="font-size: 13px; color: #555; display: flex; justify-content: space-between; margin-top: auto;">
                <span><i class="fa fa-object-group" style="color: #4cb050;"></i> 12,000 sq ft</span>
                <span><i class="fa fa-shield" style="color: #4cb050;"></i> 20-Yr NDL</span>
                <span><i class="fa fa-check-circle" style="color: #4cb050;"></i> Title 24</span> 
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var initProjects = setInterval(function() {
      if (window.jQuery && window.jQuery.fn.owlCarousel) {
        clearInterval(initProjects);
        jQuery('#latest-projects-mobile-carousel').owlCarousel({
          singleItem: true,
          autoPlay: 4500,
          stopOnHover: true,
          pagination: true,
          navigation: false
        });
      }
    }, 200);
  });
</script>

<style is:global>
  /* Global (not Astro-scoped) so rules reach the markup Owl Carousel generates via JS */
  #latest-projects-mobile-carousel .item {
    width: 100%;
    padding: 5px;
  }
  #latest-projects-mobile-carousel .owl-controls {
    display: block !important;
    margin: 15px 0 0 0 !important;
  }
  #latest-projects-mobile-carousel .owl-pagination {
    display: block !important;
    text-align: center;
    padding: 0 !important; /* theme adds 50px top/bottom here */
  }
  #latest-projects-mobile-carousel .owl-page {
    display: inline-block !important;
    padding: 0 !important;
  }
  #latest-projects-mobile-carousel .owl-page span {
    width: 12px;
    height: 12px;
    margin: 5px 6px;
    background: #D6D6D6;
    display: block;
    border-radius: 50%;
    transition: all 0.3s ease;
  }
  #latest-projects-mobile-carousel .owl-page.active span {
    background: #2384EC;
    transform: scale(1.2);
  }

  @media (max-width: 767px) {
    .latest-property {
      padding-top: 50px !important;
      padding-bottom: 10px !important;
      margin: 0 !important;
    }
    .property-lists {
      padding-top: 0 !important;
      padding-bottom: 50px !important;
      margin: 0 !important;
    }
  }
</style>

