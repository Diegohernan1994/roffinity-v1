---
// Footer Component with Roofinity brand identity and legal disclaimers
---

<footer class="footer" style="margin-top: 0; border-top: 6px solid #4cb050;">
  <div class="footer-overlay">
    <div class="container">
      

      <!-- Footer Middle -->
      <div class="footer-middle">
        <div class="row">
          
          <!-- Col 1: About Roofinity -->
          <div class="col-md-4 col-sm-6">
            <div class="footer-widget about-us">
              <div style="margin-bottom: 15px;">
                <img src="/assets/logos/roofinity-logo-white.png" alt="Roofinity Logo" style="max-height: 44px; width: auto; display: block;">
              </div>
              <p style="font-size: 13.5px; line-height: 1.6; color: #BBBBBB;">
                Roofinity is an elite residential and commercial roofing contractor licensed across California. Committed to factory-backed warranties, structural integrity, and exceptional service.
              </p>
            </div>
            <div class="social-widget-links" style="margin-top: 15px;">  
              <ul class="list-unstyled list-inline">
                <li><a href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a></li>
                <li><a href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a></li>
                <li><a href="#" aria-label="LinkedIn"><i class="fa fa-linkedin"></i></a></li>
                <li><a href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a></li>
              </ul> 
            </div>
          </div>
          
          <!-- Col 2: Services Quick Links -->
          <div class="col-md-4 col-sm-6">
            <div class="footer-widget twitter-widget">
              <h3>Core Capabilities</h3>
              <p class="clearfix">
                <span class="twittes-icon pull-left"><i class="fa fa-check-circle fa-2x" style="color: var(--rf-primary-blue);"></i></span>
                <span class="twittes">Architectural Shingles, Spanish Clay & Concrete Tile, Standing Seam Metal & Slate.</span>
              </p>
              <p class="clearfix">
                <span class="twittes-icon pull-left"><i class="fa fa-check-circle fa-2x" style="color: var(--rf-primary-blue);"></i></span>
                <span class="twittes">Commercial Single-Ply (TPO, PVC, EPDM) & Fluid-Applied Silicone Roof Restoration.</span>
              </p>
            </div>
          </div>
          
          <!-- Col 3: Contact Info -->
          <div class="col-md-4 col-sm-6">
            <div class="footer-widget contact-info">
              <h3>Contact Us</h3>
              <div class="contact-info">
                <p class="clearfix">
                  <span class="contact-icon pull-left"><i class="fa fa-check-circle fa-2x" style="color: var(--rf-primary-blue);"></i></span>
                  <span class="contact-details">11801 Pierce St, St. 200, Riverside, CA 92505</span>
                </p>
                <p class="clearfix">
                  <span class="contact-icon pull-left"><i class="fa fa-check-circle fa-2x" style="color: var(--rf-primary-blue);"></i></span>
                  <span class="contact-details">contact@roofinity.com</span>
                </p>
                <p class="clearfix">
                  <span class="contact-icon pull-left"><i class="fa fa-check-circle fa-2x" style="color: var(--rf-primary-blue);"></i></span>
                  <span class="contact-details">(951) 300-3512</span>
                </p>
                <p class="clearfix">
                  <span class="contact-icon pull-left"><i class="fa fa-check-circle fa-2x" style="color: var(--rf-primary-blue);"></i></span>
                  <span class="contact-details">CSLB License #1084920 (C-39 Roofing)</span>
                </p>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
    
    <!-- Footer Below -->
    <section class="footer-below">
      <div class="container">
        <div class="row" style="display: flex; align-items: center; flex-wrap: wrap;">
          <div class="col-md-6 col-sm-6 copy-right">
            <p style="margin: 0; color: #999999;">Copyright Â© 2026 <a href="/" style="color: var(--rf-primary-amber);">Roofinity</a>. All rights reserved. Licensed & Insured.</p>
          </div>
          
          <div class="col-md-6 col-sm-6 payment text-right">
            <ul class="list-unstyled list-inline" style="margin: 0;">
              <li><span style="color: #999999; font-size: 12px;">Financing & Major Cards:</span></li>
              <li><i class="fa fa-cc-visa" title="Visa"></i></li>
              <li><i class="fa fa-cc-mastercard" title="MasterCard"></i></li>
              <li><i class="fa fa-cc-amex" title="Amex"></i></li>
              <li><i class="fa fa-cc-discover" title="Discover"></i></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</footer>

