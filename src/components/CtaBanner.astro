---
// Urgent Call-To-Action Banner (Sell Property in EcoReal)
---

<style>
  .sell-property {
    height: auto !important;
    min-height: 200px;
    background-size: cover;
  }
  .sell-property .banner-overlay {
    height: 100% !important;
    min-height: 200px;
  }
    @media (max-width: 767px) {
    .sell-property {
      margin-top: 0px !important;
      padding-top: 0px !important;
    }
    .sell-contact { flex-wrap: wrap;
      text-align: left !important;
      margin-top: 20px;
    }
  }
    @media (max-width: 767px) {
    .sell-property {
      margin-top: 0px !important;
      padding-top: 0px !important;
    }
    .sell-contact { flex-wrap: wrap;
      justify-content: flex-start !important;
      margin-top: 15px !important;
    }
    .call-us h3 { white-space: normal !important;
      font-size: 20px !important;
      line-height: 1.3 !important;
    }
    .call-us span {
      line-height: 1.4 !important;
      margin-bottom: 10px !important;
    }
  }
</style>

<section class="sell-property">
  <div class="banner-overlay" style="background: linear-gradient(135deg, rgba(35, 132, 236, 0.94), rgba(40, 115, 240, 0.94)); padding: 25px 0;">
    <div class="container">
      <div class="row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        
        <div class="col-md-7 col-sm-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0s">
          <div class="call-us">
            <h3 style="font-size: 22px; font-weight: 700; color: #FFFFFF; margin-top: 0;">
              Need Immediate Roof Repair or a Free Drone Inspection?
            </h3>
            <span style="font-size: 15px; color: #F0EEE4; display: block; margin-top: 5px;">
              Our rapid mobile crews are ready to assess storm damage, persistent leaks, or full roof replacements.
            </span>
          </div>
        </div>
        
        <div class="col-md-5 col-sm-12 sell-contact wow fadeInUp" data-wow-duration="1s" data-wow-delay="0s" style="display: flex; justify-content: flex-end; align-items: center; padding-top: 0; margin-top: 0;">
          <span style="color: #FFFFFF; font-size: 24px; font-weight: 700; white-space: nowrap; margin-right: 20px; padding-right: 0;">
            (951) 300-3512
          </span>
          <a href="#" data-toggle="modal" data-target="#scheduleModal" style="padding: 12px 24px; white-space: nowrap; margin-left: 0; border-radius: 0 !important;">
            Book Now
          </a>
        </div>
        
      </div>
    </div>
  </div>
</section>






