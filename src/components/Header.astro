---
// Top Header Component for Roofinity
---

<header class="hidden-xs hidden-sm">
  <div class="container">
    <div class="row header" style="display: flex; align-items: center; flex-wrap: wrap;">
      <div class="col-lg-3 col-md-3 col-sm-12">
        <div class="logo">
          <a href="/">
            <img src="/assets/logos/roofinity-logo-dark.png" alt="Roofinity Logo" style="max-height: 48px; width: auto; display: block;">
          </a>
        </div>
      </div>
      <div class="col-lg-3 col-md-3 col-sm-4 header-call clearfix">
        <p>
          <i class="fa fa-phone pull-left" style="color: var(--rf-primary-blue);"></i>
          <span class="phone" style="font-weight: 700; color: #333333; font-size: 15px;">(951) 300-3512</span><br>
          <span class="info" style="color: #666666; font-size: 13px;">contact@roofinity.com</span>
        </p>
      </div>
      <div class="col-md-3 col-lg-3 col-sm-4 header-place clearfix">
        <p>
          <i class="fa fa-shield pull-left" style="color: var(--rf-primary-blue);"></i>
          <span class="address-title" style="font-weight: 700; color: #333333; font-size: 14px;">Licensed & Insured</span><br>
          <span class="address-desc" style="color: #666666; font-size: 13px;">CSLB License #1084920</span>
        </p>
      </div>
      <div class="col-md-3 col-lg-3 col-sm-4 header-social" style="display: flex; justify-content: flex-end; align-items: center;">
        <ul class="list-unstyled list-inline" style="margin: 0; padding: 0;">
          <li><a href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a></li>
          <li><a href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a></li>
          <li><a href="#" aria-label="LinkedIn"><i class="fa fa-linkedin"></i></a></li>
          <li><a href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a></li>
        </ul>
      </div>
    </div>
  </div>
</header>
<style>
  .header-call p i, .header-place p i {
    width: 44px !important;
    height: 44px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    margin-top: 0 !important;
    margin-right: 12px !important;
    font-size: 20px !important;
    line-height: normal !important;
    border: 1px solid #ddd !important;
    border-radius: 50% !important;
  }
</style>


