---
// Technical Specifications and Tabs Section (Property Details in EcoReal)
---

<section class="property-details" id="roofing-details">
  <div class="container">
    <div class="row" style="display: flex; align-items: stretch; flex-wrap: wrap;">
      <div class="col-md-6 wow fadeInUp" data-wow-delay="0.2s" style="display: flex; flex-direction: column; justify-content: center; padding-right: 25px;">
        <div class="property-detail" style="width: 100%;">
          <h2>Engineering & Standards</h2>
          <div id="content">
            <!-- Tabs Nav -->
            <ul id="tabs" class="nav nav-tabs" data-tabs="tabs" style="border-bottom: 2px solid #EAEAEA; margin-bottom: 20px;">
              <li class="active"><a href="#tab-residential" data-toggle="tab">Residential Specs</a></li>
              <li><a href="#tab-commercial" data-toggle="tab">Commercial Specs</a></li>
              <li><a href="#tab-inspection" data-toggle="tab">Inspection Protocol</a></li>
            </ul>
            
            <style>#tabs.nav-tabs > li.active > a, #tabs.nav-tabs > li.active > a:focus, #tabs.nav-tabs > li.active > a:hover { background-color: #4cb050 !important; color: #ffffff !important; border: none !important; }</style>
              <!-- Tabs Content -->
            <div id="my-tab-content" class="tab-content">
              
              <!-- Tab 1: Residential -->
              <div class="tab-pane active" id="tab-residential">
                <p style="font-size: 14.5px; line-height: 1.6; color: #555555; margin-bottom: 20px;">
                  Every residential roofing project by Roofinity follows strict multi-layered manufacturer specifications. We replace decking where compromised, install heavy-duty ice & water barriers, and utilize high-tensile starter strips engineered to endure severe winds and extreme temperature swings.
                </p>
                <div class="row"> 
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Wind:</strong> 130+ MPH</span> 
                    <span><i class="fa fa-check"></i> <strong>Impact:</strong> Class 4</span> 
                    <span><i class="fa fa-check"></i> <strong>Fire:</strong> Class A</span> 
                  </div>
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Shingles:</strong> GAF / OC</span> 
                    <span><i class="fa fa-check"></i> <strong>Underlay:</strong> Synthetic</span> 
                    <span><i class="fa fa-check"></i> <strong>Flashing:</strong> 26-Gauge</span> 
                  </div> 
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Solar:</strong> Title 24</span> 
                    <span><i class="fa fa-check"></i> <strong>Warranty:</strong> 50 Yrs</span> 
                    <span><i class="fa fa-check"></i> <strong>Labor:</strong> Lifetime</span> 
                  </div> 
                </div>
              </div>

              <!-- Tab 2: Commercial -->
              <div class="tab-pane" id="tab-commercial">
                <p style="font-size: 14.5px; line-height: 1.6; color: #555555; margin-bottom: 20px;">
                  Our commercial divisions specialize in low-slope roofing systems including thermoplastic polyolefin (TPO), polyvinyl chloride (PVC), EPDM rubber, and fluid-applied restorative elastomeric coatings. Designed for zero-ponding tolerance and optimal thermal efficiency.
                </p>
                <div class="row"> 
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Membrane:</strong> 60/80 Mil</span> 
                    <span><i class="fa fa-check"></i> <strong>Seams:</strong> Hot-Air Weld</span> 
                    <span><i class="fa fa-check"></i> <strong>Ponding:</strong> 100% Proof</span> 
                  </div>
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Reflectance:</strong> >85%</span> 
                    <span><i class="fa fa-check"></i> <strong>Chemical:</strong> Resistant</span> 
                    <span><i class="fa fa-check"></i> <strong>NDL:</strong> 20-30 Yrs</span> 
                  </div> 
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Energy:</strong> Star Rated</span> 
                    <span><i class="fa fa-check"></i> <strong>OSHA:</strong> Compliant</span> 
                    <span><i class="fa fa-check"></i> <strong>Maintenance:</strong> Bi-Annual</span> 
                  </div> 
                </div>
              </div>

              <!-- Tab 3: Inspection -->
              <div class="tab-pane" id="tab-inspection">
                <p style="font-size: 14.5px; line-height: 1.6; color: #555555; margin-bottom: 20px;">
                  Before commencing any work or filing insurance claims, Roofinity deploys 4K aerial drone mapping and infrared thermography to identify trapped moisture, damaged underlayment, and compromised flashing without setting foot on fragile surfaces.
                </p>
                <div class="row"> 
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Drone:</strong> 4K Aerial</span> 
                    <span><i class="fa fa-check"></i> <strong>Thermal:</strong> Infrared</span> 
                    <span><i class="fa fa-check"></i> <strong>Hail:</strong> Forensic</span> 
                  </div>
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Decking:</strong> Scanned</span> 
                    <span><i class="fa fa-check"></i> <strong>Attic:</strong> Ventilation</span> 
                    <span><i class="fa fa-check"></i> <strong>Insurance:</strong> Full Scope</span> 
                  </div> 
                  <div class="col-md-4 col-sm-4 water-strg">
                    <span><i class="fa fa-check"></i> <strong>Report:</strong> Digital PDF</span> 
                    <span><i class="fa fa-check"></i> <strong>Cost:</strong> 100% Free</span> 
                    <span><i class="fa fa-check"></i> <strong>Turnaround:</strong> 24 Hours</span> 
                  </div> 
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
      
      <!-- Side Image Column: Synchronized with Active Tab, Equal Height -->
      <div class="col-md-6 property-pic wow fadeInUp" data-wow-delay="0.4s" style="display: flex; flex-direction: column; justify-content: stretch;">
        <div class="tab-content" id="specs-image-content" style="height: 100%; width: 100%;">
          
          <!-- Image 1: Residential Specs -->
          <div class="tab-pane fade in active" id="tab-residential-img" style="height: 100%;">
            <img 
              src="/images/specs/specs-residential.jpg" 
              class="img-responsive" 
              alt="Roofinity Residential Roofing Engineering & Craftsmanship" 
              style="border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.12); width: 100%; height: 100%; min-height: 450px; object-fit: cover;"
            />
          </div>

          <!-- Image 2: Commercial Specs -->
          <div class="tab-pane fade" id="tab-commercial-img" style="height: 100%;">
            <img 
              src="/images/specs/specs-commercial.jpg" 
              class="img-responsive" 
              alt="Roofinity Commercial Flat Roofing Hot-Air Welding Membrane" 
              style="border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.12); width: 100%; height: 100%; min-height: 450px; object-fit: cover;"
            />
          </div>

          <!-- Image 3: Inspection Protocol -->
          <div class="tab-pane fade" id="tab-inspection-img" style="height: 100%;">
            <img 
              src="/images/hero/hero-slide-4.jpg" 
              class="img-responsive" 
              alt="Roofinity 4K Aerial Drone & Thermal Moisture Inspection Protocol" 
              style="border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.12); width: 100%; height: 100%; min-height: 450px; object-fit: cover;"
            />
          </div>

        </div>
      </div>
      
    </div>
  </div>
</section>

<script is:inline>
  // Synchronize Tab Switching with the Right-Hand Image Panes
  function setupSpecsTabSync() {
    var tabs = document.querySelectorAll('#tabs a[data-toggle="tab"]');
    tabs.forEach(function(tabLink) {
      function switchImage(targetHref) {
        var imgPane = document.querySelector(targetHref + '-img');
        if (imgPane) {
          var container = document.getElementById('specs-image-content');
          if (container) {
            container.querySelectorAll('.tab-pane').forEach(function(pane) {
              pane.classList.remove('active', 'in');
            });
            imgPane.classList.add('active', 'in');
          }
        }
      }

      tabLink.addEventListener('shown.bs.tab', function(e) {
        var href = e.target.getAttribute('href');
        switchImage(href);
      });

      tabLink.addEventListener('click', function(e) {
        var href = this.getAttribute('href');
        switchImage(href);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSpecsTabSync);
  } else {
    setupSpecsTabSync();
  }
</script>


