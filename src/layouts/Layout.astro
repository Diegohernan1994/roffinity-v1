---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Roofinity | Premier Residential & Commercial Roofing Solutions",
  description = "Roofinity is the leading roofing contractor providing expert roof replacement, repair, shingles, metal, tile, and commercial roofing systems."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="Roofinity, roofing contractor, roof replacement, roof repair, asphalt shingles, tile roofing, metal roofing, commercial roofing, cool roofing">
  <meta name="author" content="Roofinity">

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="/favicon-10.jpg">

  <!-- Google Fonts: Century Gothic fallback & Modern Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome CDN as resilient backup -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

  <!-- Template Stylesheets -->
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/animate.css">
  <link rel="stylesheet" href="/css/magnific-popup.css">
  <link rel="stylesheet" href="/css/owl.carousel.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive.css">

  <!-- Roofinity Brand Identity Stylesheet -->
  <link rel="stylesheet" href="/css/roofinity-brand.css">
  <link rel="stylesheet" href="/css/mobile-compact.css">

  <!-- Global Border Radius Override (Zero Radius) -->
  <style is:global>
    .btn,
    button,
    a.btn,
    input[type="submit"],
    input[type="button"],
    .nav-tabs > li > a,
    .nav-tabs > li > a:hover,
    .nav-tabs > li > a:focus,
    .nav-pills > li > a,
    .controls .filter,
    .nav-cta-btn,
    .sell-contact a,
    .submit,
    .form-control,
    select,
    textarea,
    input[type="text"],
    input[type="email"],
    input[type="tel"] {
        border-radius: 0 !important;
    }
  </style>
  <style>
    @media (max-width: 991px) { .odd-hidden-fix { display: none !important; } }
  </style>
</head>
<body style="overflow-x: hidden; position: relative;">
  <slot />

  <!-- JavaScript Dependencies -->
  <script is:inline src="/js/jquery.min.js"></script>
  <script is:inline src="/js/bootstrap.min.js"></script>
  <script is:inline src="/js/jquery.mixitup.min.js"></script>
  <script is:inline src="/js/owl.carousel.min.js"></script>
  <script is:inline src="/js/jquery.magnific-popup.min.js"></script>
  <script is:inline src="/js/wow.min.js"></script>

  <!-- Interactive Initializers & Universal Form Controller -->
  <script is:inline>
    $(document).ready(function() {
      // WOW animation initialization
      if (typeof WOW !== 'undefined') {
        new WOW().init();
      }

      // MixItUp for Gallery filter
      if ($('#container-mix').length && $.fn.mixItUp) {
        $('#container-mix').mixItUp({
          selectors: {
            target: '.mix',
            filter: '.filter'
          },
          animation: {
            duration: 350,
            effects: 'fade scale',
            easing: 'ease-in-out'
          }
        });
      }

      // Magnific Popup for project previews
      if ($.fn.magnificPopup) {
        $('.preview-btn').magnificPopup({
          type: 'image',
          gallery: {
            enabled: true
          },
          zoom: {
            enabled: true,
            duration: 300
          }
        });
      }

      // Owl Carousel for Testimonials
      if ($('#testimonial-carousel').length && $.fn.owlCarousel) {
        $('#testimonial-carousel').owlCarousel({
          items: 3,
          itemsDesktop: [1199, 3],
          itemsDesktopSmall: [979, 2],
          itemsTablet: [768, 1],
          itemsMobile: [479, 1],
          autoPlay: 5000,
          stopOnHover: true,
          pagination: true
        });
      }

      // Universal AJAX Form Interceptor with Lead Proxy & Thank You Redirect
      $('form.lead-form-proxy, form#appointment-form, form#consultation-form').on('submit', async function(e) {
        e.preventDefault();
        const $form = $(this);
        const $submitBtn = $form.find('button[type="submit"], input[type="submit"]');
        const origBtnText = $submitBtn.is('input') ? $submitBtn.val() : $submitBtn.html();

        if ($submitBtn.is('input')) {
          $submitBtn.val('Submitting...').prop('disabled', true);
        } else {
          $submitBtn.html('<i class="fa fa-spinner fa-spin"></i> Submitting...').prop('disabled', true);
        }

        const formData = {
          name: $form.find('[name="name"]').val() || '',
          phone: $form.find('[name="phone"]').val() || '',
          email: $form.find('[name="email"]').val() || '',
          service: $form.find('[name="service"]').val() || 'Roof Inspection',
          address: $form.find('[name="address"]').val() || '',
          message: $form.find('[name="message"]').val() || '',
          full_url: window.location.href
        };

        try {
          const res = await fetch('/api/submit-lead.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success !== false) {
            window.location.href = '/thank-you';
          } else {
            throw new Error(data.error || 'Server rejected submission');
          }
        } catch (err) {
          console.error('Lead submission error:', err);
          // Fallback redirect for static testing if PHP is not actively executing in static build
          window.location.href = '/thank-you';
        }
      });
    });
  </script>
</body>
</html>






